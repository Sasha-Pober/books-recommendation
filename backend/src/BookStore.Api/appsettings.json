{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BookStore": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Events": {
    "Capacity": 10000,
    "BatchSize": 500,
    "FlushInterval": "00:00:01",
    "MaxAttempts": 3
