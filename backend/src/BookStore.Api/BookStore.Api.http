@host = http://localhost:5292

### Health
GET {{host}}/health

### Full-text search (Ukrainian word forms: «дюну» finds «Дюна»), ranked by relevance
GET {{host}}/api/books?search=дюну&page=1&pageSize=10

### Filters and sorting (genreId includes subgenres)
GET {{host}}/api/books?minPrice=200&maxPrice=400&minYear=1950&inStockOnly=true&language=uk&sort=PriceAscending

### Reference lists for filters
GET {{host}}/api/genres

###
GET {{host}}/api/publishers

###
GET {{host}}/api/series

### Register a customer (guest events of this browser session are attached to the new account)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "reader@example.com",
  "password": "Reader123!",
  "fullName": "Читач"
}

### Log in as the seeded demo customer
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@bookstore.local",
  "password": "Customer123!"
}

### Current user
GET {{host}}/api/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### Refresh tokens (the refresh token is single-use)
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Record a view (the only event type clients send; works for guests without the Authorization header)
POST {{host}}/api/interactions
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "events": [
    { "bookId": "00000000-0000-0000-0000-000000000000", "type": "View" }
  ]
}

### Add to cart (replace the book id)
POST {{host}}/api/cart
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "bookId": "00000000-0000-0000-0000-000000000000", "quantity": 1 }

### Cart
GET {{host}}/api/cart
Authorization: Bearer {{login.response.body.$.accessToken}}

### Place an order from the cart
POST {{host}}/api/orders
Authorization: Bearer {{login.response.body.$.accessToken}}

### My orders
GET {{host}}/api/orders
Authorization: Bearer {{login.response.body.$.accessToken}}

### Add to wishlist (replace the book id)
POST {{host}}/api/wishlist
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "bookId": "00000000-0000-0000-0000-000000000000" }

### Rate a book (replace the book id)
POST {{host}}/api/books/00000000-0000-0000-0000-000000000000/ratings
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "score": 5, "reviewText": "Чудова книга!" }

### Reviews of a book
GET {{host}}/api/books/00000000-0000-0000-0000-000000000000/ratings

### Recommendations: personalized when signed in, popular for guests
GET {{host}}/api/recommendations/home?count=10
Authorization: Bearer {{login.response.body.$.accessToken}}

### Similar books (replace id)
GET {{host}}/api/recommendations/books/00000000-0000-0000-0000-000000000000/similar?count=5

### Log out (revokes the refresh token)
POST {{host}}/api/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Log in as the demo manager (catalog management)
# @name managerLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "manager@bookstore.local",
  "password": "Manager123!"
}

### Create a publisher
POST {{host}}/api/admin/publishers
Authorization: Bearer {{managerLogin.response.body.$.accessToken}}
Content-Type: application/json

{ "name": "Наш Формат" }

### Create a book (replace the author id; GET /api/authors lists them)
POST {{host}}/api/admin/books
Authorization: Bearer {{managerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "title": "Нова книга",
  "annotation": "Коротка анотація.",
  "language": "uk",
  "year": 2026,
  "price": 299,
  "stock": 5,
  "authorIds": ["00000000-0000-0000-0000-000000000000"]
}
